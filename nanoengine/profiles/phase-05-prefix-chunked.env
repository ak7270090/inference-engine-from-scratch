# Phase 5: paged KV cache + continuous batching + automatic prefix caching + chunked prefill
NANOENGINE_KV_CACHE=paged
NANOENGINE_SCHEDULER=continuous
NANOENGINE_PREFIX_CACHE=true
NANOENGINE_CHUNKED_PREFILL=true
NANOENGINE_MAX_NUM_BATCHED_TOKENS=256
NANOENGINE_MAX_MODEL_LEN=2048
NANOENGINE_MAX_NUM_SEQS=64
NANOENGINE_KV_CACHE_MEMORY_MB=4096
NANOENGINE_KV_BLOCK_SIZE=16
