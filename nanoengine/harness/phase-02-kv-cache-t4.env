# Phase 2 on a Kaggle T4 (fp16): one request at a time, decode reads the KV cache
HARNESS_TARGET_URL=http://localhost:8000
HARNESS_WORKLOAD_SCALE=t4
HARNESS_CONCURRENCY_LEVELS=[1,4]
# fp16 greedy outputs can differ from the fp32 CPU reference
HARNESS_SKIPPED_SUITES=["equivalence","long_prompt_interference"]
HARNESS_EXPECTED_FAILURES=["concurrency","prefix_reuse"]
