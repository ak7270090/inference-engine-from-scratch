# phase-03-continuous-batching on a Kaggle T4 (fp16): many users share each step
HARNESS_TARGET_URL=http://localhost:8000
HARNESS_WORKLOAD_SCALE=t4
HARNESS_CONCURRENCY_LEVELS=[1,4,16,64]
HARNESS_CONCURRENCY_MIN_SPEEDUP=4.0
HARNESS_SKIPPED_SUITES=["equivalence"]
# no prefix cache yet; whole-prompt prefill steps still stall other streams (phase 5)
HARNESS_EXPECTED_FAILURES=["prefix_reuse","long_prompt_interference"]
