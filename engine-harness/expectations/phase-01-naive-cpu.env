# Phase 1 on a laptop CPU (fp32): one request at a time, no KV cache.
HARNESS_TARGET_URL=http://localhost:8000
HARNESS_WORKLOAD_SCALE=cpu
HARNESS_CONCURRENCY_LEVELS=[1,2,4]
# serial engine: more users do not add throughput, and nothing is cached
HARNESS_EXPECTED_FAILURES=["concurrency","prefix_reuse"]
# without batching a running stream is never interrupted, so this suite says nothing yet
HARNESS_SKIPPED_SUITES=["long_prompt_interference"]
