    {"type": "text", "id": "req_label", "x": 20, "y": 430, "width": 880, "height": 20, "text": "one streaming request, identical for every phase and for vLLM", "originalText": "one streaming request, identical for every phase and for vLLM", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "req_panel", "x": 20, "y": 460, "width": 900, "height": 200, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "roundness": {"type": 3}},
    {"type": "text", "id": "req_text", "x": 40, "y": 478, "width": 860, "height": 165, "text": "POST /v1/completions\n{\"prompt\": \"Capital of India?\", \"max_tokens\": 128,\n \"temperature\": 0, \"stream\": true}\n\ndata: {\"choices\":[{\"text\":\" New\"}]}     t=212 ms  TTFT\ndata: {\"choices\":[{\"text\":\" Delhi\"}]}   t=230 ms  ITL 18 ms\ndata: [DONE]", "originalText": "POST /v1/completions\n{\"prompt\": \"Capital of India?\", \"max_tokens\": 128,\n \"temperature\": 0, \"stream\": true}\n\ndata: {\"choices\":[{\"text\":\" New\"}]}     t=212 ms  TTFT\ndata: {\"choices\":[{\"text\":\" Delhi\"}]}   t=230 ms  ITL 18 ms\ndata: [DONE]", "fontSize": 16, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 1},

    {"type": "text", "id": "wl_label", "x": 970, "y": 430, "width": 900, "height": 20, "text": "standard workloads (token counts from the Qwen3 tokenizer)", "originalText": "standard workloads (token counts from the Qwen3 tokenizer)", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "wl_panel", "x": 970, "y": 460, "width": 900, "height": 200, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "roundness": {"type": 3}},
    {"type": "text", "id": "wl_text", "x": 990, "y": 478, "width": 860, "height": 165, "text": "short_chat        64 in / 128 out      decode speed, ITL\nlong_prompt    1,024 in /  32 out      prefill, TTFT\nshared_prefix  512+32 in /  64 out     prefix caching\nmixed_lengths     64 in / 16-512 out   batching waste\nburst          64 requests at once     queue, preemption\n\nscale: cpu (local, 1-8 users) | t4 (Kaggle, 1-64 users)", "originalText": "short_chat        64 in / 128 out      decode speed, ITL\nlong_prompt    1,024 in /  32 out      prefill, TTFT\nshared_prefix  512+32 in /  64 out     prefix caching\nmixed_lengths     64 in / 16-512 out   batching waste\nburst          64 requests at once     queue, preemption\n\nscale: cpu (local, 1-8 users) | t4 (Kaggle, 1-64 users)", "fontSize": 16, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 1}
  ],
