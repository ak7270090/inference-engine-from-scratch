    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 1300, "height": 35, "text": "Inference engine from scratch: one API, seven upgrades, measured against vLLM", "originalText": "Inference engine from scratch: one API, seven upgrades, measured against vLLM", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
