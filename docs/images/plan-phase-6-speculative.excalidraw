    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 1300, "height": 35, "text": "Phase 6: guess k tokens cheaply, check them all in one big-model pass", "originalText": "Phase 6: guess k tokens cheaply, check them all in one big-model pass", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
    {"type": "text", "id": "subtitle", "x": 20, "y": 62, "width": 1500, "height": 20, "text": "The target model has the final say on every token, so the output does not change. The gain shrinks as the batch grows and the GPU stops being idle.", "originalText": "The target model has the final say on every token, so the output does not change. The gain shrinks as the batch grows and the GPU stops being idle.", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},

