    {"type": "rectangle", "id": "seats_panel", "x": 20, "y": 428, "width": 690, "height": 190, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "roundness": {"type": 3}},
    {"type": "text", "id": "seats_text", "x": 40, "y": 444, "width": 650, "height": 160, "text": "step         1 2 3 4 5 6 7 8\nstatic  s1   A A A . . . . .\n        s2   B B B B B B B B\n        s3   C C . . . . . .   D, E wait\ncontin. s1   A A A D D D D D\n        s2   B B B B B B B B\n        s3   C C E E E E E E   no empty seat", "originalText": "step         1 2 3 4 5 6 7 8\nstatic  s1   A A A . . . . .\n        s2   B B B B B B B B\n        s3   C C . . . . . .   D, E wait\ncontin. s1   A A A D D D D D\n        s2   B B B B B B B B\n        s3   C C E E E E E E   no empty seat", "fontSize": 16, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 1},

    {"type": "text", "id": "loop_label", "x": 760, "y": 400, "width": 640, "height": 20, "text": "engine_loop.py: one background task", "originalText": "engine_loop.py: one background task", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "loop_panel", "x": 760, "y": 428, "width": 640, "height": 190, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "roundness": {"type": 3}},
    {"type": "text", "id": "loop_text", "x": 780, "y": 444, "width": 600, "height": 160, "text": "while True:\n    scheduler.remove_finished()\n    scheduler.admit_waiting()   # prefill new\n    batch = batch_builder.build(running)\n    logits = model.forward(batch)\n    stream_tokens(sample(logits))", "originalText": "while True:\n    scheduler.remove_finished()\n    scheduler.admit_waiting()   # prefill new\n    batch = batch_builder.build(running)\n    logits = model.forward(batch)\n    stream_tokens(sample(logits))", "fontSize": 16, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 1}
