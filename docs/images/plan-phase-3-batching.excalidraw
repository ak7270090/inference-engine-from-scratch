    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 1300, "height": 35, "text": "Phase 3: a scheduler decides every step which sequences share the GPU", "originalText": "Phase 3: a scheduler decides every step which sequences share the GPU", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
