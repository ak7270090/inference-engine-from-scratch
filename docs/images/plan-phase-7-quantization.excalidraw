    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 1300, "height": 35, "text": "Phase 7: fewer bytes per step, fewer launches per step", "originalText": "Phase 7: fewer bytes per step, fewer launches per step", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
    {"type": "text", "id": "subtitle", "x": 20, "y": 62, "width": 1450, "height": 20, "text": "Decode is limited by memory reads and, in eager PyTorch at small batch, by kernel launch overhead. Attack both, and measure the quality cost.", "originalText": "Decode is limited by memory reads and, in eager PyTorch at small batch, by kernel launch overhead. Attack both, and measure the quality cost.", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},

