    {"type": "text", "id": "kv_note", "x": 470, "y": 270, "width": 220, "height": 40, "text": "-> 2x tokens fit\n   in the pool", "originalText": "-> 2x tokens fit\n   in the pool", "fontSize": 14, "fontFamily": 3, "strokeColor": "#047857", "roughness": 1},

    {"type": "rectangle", "id": "q_panel", "x": 20, "y": 330, "width": 680, "height": 140, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "roundness": {"type": 3}},
    {"type": "text", "id": "q_text", "x": 38, "y": 344, "width": 650, "height": 115, "text": "scale  = w.abs().amax(dim=1) / 127   # one per output channel\nw_int8 = torch.round(w / scale[:, None]).to(torch.int8)\ny      = (x @ w_int8.T.to(x.dtype)) * scale\nkv_int8 + kv_scale per block           # int8_kv_cache.py", "originalText": "scale  = w.abs().amax(dim=1) / 127   # one per output channel\nw_int8 = torch.round(w / scale[:, None]).to(torch.int8)\ny      = (x @ w_int8.T.to(x.dtype)) * scale\nkv_int8 + kv_scale per block           # int8_kv_cache.py", "fontSize": 16, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 1},

