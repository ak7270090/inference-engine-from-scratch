  "elements": [
    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 1300, "height": 35, "text": "Phase 5: reuse shared prompt blocks, and never let one prompt freeze the batch", "originalText": "Phase 5: reuse shared prompt blocks, and never let one prompt freeze the batch", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
    {"type": "text", "id": "subtitle", "x": 20, "y": 62, "width": 1400, "height": 20, "text": "Left: a full block is found by the hash of its tokens and its parent. Right: each step has a token budget, so long prompts are read in chunks.", "originalText": "Left: a full block is found by the hash of its tokens and its parent. Right: each step has a token budget, so long prompts are read in chunks.", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},

    {"type": "text", "id": "left_head", "x": 20, "y": 108, "width": 600, "height": 22, "text": "prefix caching: same system prompt, same blocks", "originalText": "prefix caching: same system prompt, same blocks", "fontSize": 18, "fontFamily": 3, "strokeColor": "#3b82f6", "roughness": 1},
    {"type": "text", "id": "r1_l", "x": 20, "y": 158, "width": 100, "height": 20, "text": "request 1", "originalText": "request 1", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "r1a", "x": 130, "y": 145, "width": 150, "height": 50, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "boundElements": [{"id": "r1a_t", "type": "text"}]},
    {"type": "text", "id": "r1a_t", "x": 135, "y": 150, "width": 140, "height": 40, "text": "system 0-15\nblock 5", "originalText": "system 0-15\nblock 5", "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "containerId": "r1a", "roughness": 1},
    {"type": "rectangle", "id": "r1b", "x": 290, "y": 145, "width": 150, "height": 50, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "boundElements": [{"id": "r1b_t", "type": "text"}]},
    {"type": "text", "id": "r1b_t", "x": 295, "y": 150, "width": 140, "height": 40, "text": "system 16-31\nblock 8", "originalText": "system 16-31\nblock 8", "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "containerId": "r1b", "roughness": 1},
    {"type": "rectangle", "id": "r1c", "x": 450, "y": 145, "width": 170, "height": 50, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "boundElements": [{"id": "r1c_t", "type": "text"}]},
    {"type": "text", "id": "r1c_t", "x": 455, "y": 150, "width": 160, "height": 40, "text": "Track my order\nblock 11", "originalText": "Track my order\nblock 11", "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "containerId": "r1c", "roughness": 1},

    {"type": "text", "id": "r2_l", "x": 20, "y": 238, "width": 100, "height": 20, "text": "request 2", "originalText": "request 2", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "r2a", "x": 130, "y": 225, "width": 150, "height": 50, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "boundElements": [{"id": "r2a_t", "type": "text"}]},
    {"type": "text", "id": "r2a_t", "x": 135, "y": 230, "width": 140, "height": 40, "text": "reuse 5\nref count 2", "originalText": "reuse 5\nref count 2", "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "containerId": "r2a", "roughness": 1},
    {"type": "rectangle", "id": "r2b", "x": 290, "y": 225, "width": 150, "height": 50, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "boundElements": [{"id": "r2b_t", "type": "text"}]},
    {"type": "text", "id": "r2b_t", "x": 295, "y": 230, "width": 140, "height": 40, "text": "reuse 8\nref count 2", "originalText": "reuse 8\nref count 2", "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "containerId": "r2b", "roughness": 1},
    {"type": "rectangle", "id": "r2c", "x": 450, "y": 225, "width": 170, "height": 50, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "boundElements": [{"id": "r2c_t", "type": "text"}]},
    {"type": "text", "id": "r2c_t", "x": 455, "y": 230, "width": 160, "height": 40, "text": "Refund please\nprefill only this", "originalText": "Refund please\nprefill only this", "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#374151", "containerId": "r2c", "roughness": 1},
    {"type": "arrow", "id": "a_share1", "x": 205, "y": 197, "width": 0, "height": 26, "points": [[0, 0], [0, 26]], "strokeColor": "#047857", "strokeWidth": 2, "roughness": 1, "endArrowhead": "arrow"},
    {"type": "arrow", "id": "a_share2", "x": 365, "y": 197, "width": 0, "height": 26, "points": [[0, 0], [0, 26]], "strokeColor": "#047857", "strokeWidth": 2, "roughness": 1, "endArrowhead": "arrow"},

    {"type": "rectangle", "id": "hash_panel", "x": 20, "y": 310, "width": 680, "height": 200, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "roundness": {"type": 3}},
    {"type": "text", "id": "hash_text", "x": 38, "y": 326, "width": 650, "height": 170, "text": "h1 = hash(None, tokens[0:16])   -> block 5\nh2 = hash(h1,   tokens[16:32])  -> block 8\n\nrequest 2 finds h1, h2: ref_count 5 -> 2, 8 -> 2\nskips 32 of 48 prompt tokens (prefill only the tail)\nfreed blocks stay cached until evicted (LRU)", "originalText": "h1 = hash(None, tokens[0:16])   -> block 5\nh2 = hash(h1,   tokens[16:32])  -> block 8\n\nrequest 2 finds h1, h2: ref_count 5 -> 2, 8 -> 2\nskips 32 of 48 prompt tokens (prefill only the tail)\nfreed blocks stay cached until evicted (LRU)", "fontSize": 16, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 1},

