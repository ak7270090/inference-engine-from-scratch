    {"type": "text", "id": "cfg_label", "x": 20, "y": 370, "width": 600, "height": 20, "text": "Qwen3-0.6B config.json (what qwen3_model.py implements)", "originalText": "Qwen3-0.6B config.json (what qwen3_model.py implements)", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "cfg_panel", "x": 20, "y": 398, "width": 620, "height": 150, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "roundness": {"type": 3}},
    {"type": "text", "id": "cfg_text", "x": 40, "y": 414, "width": 580, "height": 120, "text": "\"hidden_size\": 1024,     \"num_hidden_layers\": 28,\n\"num_attention_heads\": 16,\n\"num_key_value_heads\": 8, \"head_dim\": 128,\n\"vocab_size\": 151936,    \"tie_word_embeddings\": true\nRMSNorm + RoPE + QK-norm + SwiGLU", "originalText": "\"hidden_size\": 1024,     \"num_hidden_layers\": 28,\n\"num_attention_heads\": 16,\n\"num_key_value_heads\": 8, \"head_dim\": 128,\n\"vocab_size\": 151936,    \"tie_word_embeddings\": true\nRMSNorm + RoPE + QK-norm + SwiGLU", "fontSize": 16, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 1},

    {"type": "text", "id": "test_label", "x": 690, "y": 370, "width": 700, "height": 20, "text": "correctness test: my model vs Hugging Face transformers", "originalText": "correctness test: my model vs Hugging Face transformers", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "test_panel", "x": 690, "y": 398, "width": 710, "height": 150, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "roundness": {"type": 3}},
    {"type": "text", "id": "test_text", "x": 710, "y": 414, "width": 670, "height": 120, "text": "def test_logits_match_transformers(tiny_qwen3):\n    ours = qwen3_model(input_ids)\n    reference = hf_qwen3(input_ids).logits\n    assert torch.allclose(ours, reference, atol=1e-4)\n# + 50 greedy prompts saved to reference/", "originalText": "def test_logits_match_transformers(tiny_qwen3):\n    ours = qwen3_model(input_ids)\n    reference = hf_qwen3(input_ids).logits\n    assert torch.allclose(ours, reference, atol=1e-4)\n# + 50 greedy prompts saved to reference/", "fontSize": 16, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 1}
  ],
