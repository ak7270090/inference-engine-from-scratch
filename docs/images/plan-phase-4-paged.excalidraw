    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 1300, "height": 35, "text": "Phase 4: KV memory becomes a pool of 16-token blocks, given out on demand", "originalText": "Phase 4: KV memory becomes a pool of 16-token blocks, given out on demand", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
    {"type": "text", "id": "subtitle", "x": 20, "y": 62, "width": 1400, "height": 20, "text": "A sequence's blocks can sit anywhere; its block table says where. Nothing is reserved for tokens that may never come.", "originalText": "A sequence's blocks can sit anywhere; its block table says where. Nothing is reserved for tokens that may never come.", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},

