    {"type": "text", "id": "api_label", "x": 980, "y": 108, "width": 420, "height": 20, "text": "allocator and cache shape", "originalText": "allocator and cache shape", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b", "roughness": 1},
    {"type": "rectangle", "id": "api_panel", "x": 980, "y": 130, "width": 460, "height": 176, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "roundness": {"type": 3}},
    {"type": "text", "id": "api_text", "x": 996, "y": 144, "width": 430, "height": 150, "text": "allocator.allocate(1)   -> [12]\nallocator.free([1, 9])\nallocator.num_free      -> 19\n\nkey_cache[layer]:\n  [num_blocks, 16, 8, 128]", "originalText": "allocator.allocate(1)   -> [12]\nallocator.free([1, 9])\nallocator.num_free      -> 19\n\nkey_cache[layer]:\n  [num_blocks, 16, 8, 128]", "fontSize": 16, "fontFamily": 3, "strokeColor": "#22c55e", "roughness": 1},

    {"type": "text", "id": "tl_head", "x": 20, "y": 350, "width": 600, "height": 20, "text": "what the scheduler does over time", "originalText": "what the scheduler does over time", "fontSize": 16, "fontFamily": 3, "strokeColor": "#3b82f6", "roughness": 1},
    {"type": "line", "id": "tl", "x": 30, "y": 400, "width": 1000, "height": 0, "points": [[0, 0], [1000, 0]], "strokeColor": "#1e3a5f", "strokeWidth": 2, "roughness": 1},
    {"type": "ellipse", "id": "e1", "x": 64, "y": 394, "width": 12, "height": 12, "strokeColor": "#3b82f6", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1},
    {"type": "ellipse", "id": "e2", "x": 404, "y": 394, "width": 12, "height": 12, "strokeColor": "#047857", "backgroundColor": "#047857", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1},
    {"type": "ellipse", "id": "e3", "x": 744, "y": 394, "width": 12, "height": 12, "strokeColor": "#b91c1c", "backgroundColor": "#b91c1c", "fillStyle": "solid", "strokeWidth": 1, "roughness": 1},
    {"type": "text", "id": "e1_t", "x": 40, "y": 416, "width": 320, "height": 40, "text": "A writes token 33:\nblock 3 full -> allocate 12", "originalText": "A writes token 33:\nblock 3 full -> allocate 12", "fontSize": 16, "fontFamily": 3, "strokeColor": "#1e3a5f", "roughness": 1},
    {"type": "text", "id": "e2_t", "x": 380, "y": 416, "width": 320, "height": 40, "text": "B finishes:\nblocks 1, 9 back to free list", "originalText": "B finishes:\nblocks 1, 9 back to free list", "fontSize": 16, "fontFamily": 3, "strokeColor": "#047857", "roughness": 1},
    {"type": "text", "id": "e3_t", "x": 720, "y": 416, "width": 340, "height": 60, "text": "pool empty: preempt the\nnewest sequence, re-queue it,\nrecompute its cache later", "originalText": "pool empty: preempt the\nnewest sequence, re-queue it,\nrecompute its cache later", "fontSize": 16, "fontFamily": 3, "strokeColor": "#b91c1c", "roughness": 1},

    {"type": "rectangle", "id": "res", "x": 1100, "y": 350, "width": 340, "height": 130, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "roundness": {"type": 3}, "boundElements": [{"id": "res_t", "type": "text"}]},
    {"type": "text", "id": "res_t", "x": 1118, "y": 365, "width": 310, "height": 100, "text": "same KV budget:\n03 reserves 4,096 tokens\n   per sequence\n04 stores only blocks in use\ntarget: >= 2x sequences", "originalText": "same KV budget:\n03 reserves 4,096 tokens\n   per sequence\n04 stores only blocks in use\ntarget: >= 2x sequences", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "containerId": "res", "roughness": 1}
